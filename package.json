{
	"name": "@develappers/n8n-nodes-ilai",
	"version": "0.1.0",
	"description": "n8n community node for ILAI (Impact Labs AI) – manage calls, agents, FAQs, processes, prompts and more",
	"license": "MIT",
	"homepage": "https://impact-labs.ai/",
	"keywords": [
		"n8n-community-node-package",
		"ilai",
		"impact-labs",
		"voice-ai",
		"call-center"
	],
	"author": {
		"name": "Martin Hey",
		"email": "martinhey@gmx.de"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/develappers/n8n-nodes-ilai.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/IlaiApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Ilai/Ilai.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/jest": "^30.0.0",
		"eslint": "9.39.4",
		"jest": "^30.0.0",
		"n8n-workflow": "*",
		"prettier": "3.8.3",
		"release-it": "21.0.2",
		"ts-jest": "^29.2.5",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
